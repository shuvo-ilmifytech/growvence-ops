# Production environment for OpsFlow. Lives at the REPO ROOT as .env on the
# server (docker compose reads it automatically). Never commit it.
# 02-deploy.sh writes this file with fresh secrets on the first run.

# --------------------------------------------------------------- public faces
# Full site addresses, scheme included. See deploy/Caddyfile.
#   no DNS yet:    http://<ip>              http://<ip>:9443
#   real hostname: https://portal.example   https://files.portal.example
APP_SITE=http://127.0.0.1
FILES_SITE=http://127.0.0.1:9443

# ------------------------------------------------------------------- the app
# APP_ORIGINS must equal APP_SITE: the API rejects state-changing requests from
# any other origin. COOKIE_SECURE must be false on http:// or nobody can log in
# (the browser withholds a Secure cookie over plaintext), and true on https://.
APP_ORIGINS=http://127.0.0.1
COOKIE_SECURE=false
AUTO_MIGRATE=true

# ------------------------------------------------------------------- secrets
# Generated once. Changing POSTGRES_PASSWORD later does NOT change the password
# already baked into the database volume.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=opsflow

# ------------------------------------------------ object storage, as the browser sees it
# Must match FILES_SITE's host[:port] exactly — presigned URLs are signed over
# the Host header.
S3_PUBLIC_ENDPOINT=127.0.0.1:9443
S3_PUBLIC_SSL=false

# ------------------------------------------------- published ports (LOOPBACK!)
# The leading 127.0.0.1 is the point: these must never be reachable from the
# internet. Docker's iptables rules bypass ufw, so binding to loopback is what
# actually keeps them private. Reach them over an SSH tunnel, e.g.
#   ssh -L 5442:127.0.0.1:5442 mehexi@<server>
POSTGRES_PORT=127.0.0.1:5442
REDIS_PORT=127.0.0.1:6390
MINIO_PORT=127.0.0.1:9010
MINIO_CONSOLE_PORT=127.0.0.1:9011
API_PORT=127.0.0.1:8080
WEB_PORT=127.0.0.1:3000

# ----------------------------------------------- Google Sheet backup (optional)
# Needs a service account with the Sheets API enabled, and the sheet shared with
# its address as an Editor. Empty id = switched off.
SHEETS_SPREADSHEET_ID=
SHEETS_TAB=Projects
SHEETS_SYNC_EVERY=30s
GOOGLE_SERVICE_ACCOUNT_FILE=

# ------------------------------------------------------------- voice calls
# STUN finds a direct path between two browsers. TURN relays the audio when the
# networks refuse one (common on mobile data and locked-down office Wi-Fi).
# Without a TURN server those particular calls fail with a clear message.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# The bundled coturn relay (the `turn` service): TURN_URL points at this server,
# TURN_EXTERNAL_IP is its public IP, and the username/password are shared by the
# relay and the api. Generate the password with `openssl rand -hex 24`.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
TURN_EXTERNAL_IP=
TURN_REALM=
