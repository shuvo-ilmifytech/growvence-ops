# Backend
DATABASE_URL=postgres://opsflow:opsflow@localhost:5442/opsflow?sslmode=disable
REDIS_URL=redis://localhost:6390/0
API_ADDR=:8080
APP_ORIGINS=http://localhost:3000
# true behind HTTPS
COOKIE_SECURE=false
# idle timeout (sliding) / absolute lifetime
SESSION_TTL=168h
SESSION_MAX_AGE=720h
AUTO_MIGRATE=true

# Integration tests (user needs CREATEDB)
TEST_DATABASE_URL=postgres://opsflow:opsflow@localhost:5442/postgres?sslmode=disable
TEST_REDIS_URL=redis://localhost:6390/0

# Frontend
API_INTERNAL_URL=http://localhost:8080

# Object storage (S3 / MinIO). PUBLIC_ENDPOINT is what browsers reach for presigned URLs.
S3_ENDPOINT=localhost:9010
S3_PUBLIC_ENDPOINT=localhost:9010
S3_ACCESS_KEY=opsflow
S3_SECRET_KEY=opsflow-secret
S3_BUCKET=opsflow
S3_REGION=us-east-1
S3_USE_SSL=false
MAX_UPLOAD_MB=100
TEST_S3_BUCKET=opsflow-test

# Google Sheet backup (optional): one row per project, kept in step with the app.
# Create a service account, enable the Sheets API, download its JSON key, and share
# the spreadsheet with the service account's address as an Editor.
# The id is the long part of the sheet's URL: /spreadsheets/d/<THIS>/edit
SHEETS_SPREADSHEET_ID=
SHEETS_TAB=Projects
SHEETS_SYNC_EVERY=30s
GOOGLE_SERVICE_ACCOUNT_FILE=
# ...or paste the key itself instead of a path:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Voice calls. STUN finds a direct path between two browsers; TURN relays the audio
# when their networks won't allow one (needed on some mobile and office networks).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
